# Copy to backend/.env and fill in before running locally
# Variables below are ignored by git via the *.env rule in .gitignore.

DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DATABASE_URL unset for local development (falls back to SQLite
# automatically). Railway injects its own postgres:// DATABASE_URL.
# DATABASE_URL=postgres://user:pass@host:5432/dbname
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5174
